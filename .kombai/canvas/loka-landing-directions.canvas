               Calcul des commissions\n                                </li>\n                                <li class=\"flex gap-3\" data-kid=\"1-3-6-1-2-3-1-5-4\" data-name=\"feature 4\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check-circle text-[17px] text-[#4338ca]\" data-kid=\"1-3-6-1-2-3-1-5-4-1\" data-name=\"icon\">\n                                    </i>\n                                    Accès multi-utilisateurs\n                                </li>\n                            </ul>\n                        </div>\n                        <a class=\"mt-9 inline-flex min-h-12 items-center justify-center rounded-full border border-[#4338ca] px-5 text-[13px] font-bold text-[#312e81] hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-3-6-1-2-3-2\" data-name=\"signup button\" href=\"/login?tab=signup\">\n                            Parler à l’équipe\n                        </a>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#f8fafc] px-5 py-24 sm:px-8 lg:px-12 lg:py-32\" data-kid=\"1-3-7\" data-name=\"faq section\" id=\"faq\">\n            <div class=\"mx-auto max-w-4xl\" data-kid=\"1-3-7-1\" data-name=\"faq container\">\n                <div class=\"mb-12 text-center\" data-kid=\"1-3-7-1-1\" data-name=\"section header\">\n                    <p class=\"reveal text-[11px] font-bold uppercase tracking-[0.18em] text-[#d67a52]\" data-kid=\"1-3-7-1-1-1\" data-name=\"kicker label\">\n                        Questions fréquentes\n                    </p>\n                    <h2 class=\"reveal mt-4 font-display text-[42px] font-semibold leading-[1.08] tracking-[-0.035em] text-[#312e81]\" data-kid=\"1-3-7-1-1-2\" data-name=\"main heading\">\n                        Tout devient plus simple\n                        <br data-kid=\"1-3-7-1-1-2-1\" data-name=\"line break\"/>\n                        quand c’est clair.\n                    </h2>\n                </div>\n                <div class=\"divide-y divide-[#d6d3d1] border-y border-[#d6d3d1]\" data-kid=\"1-3-7-1-2\" data-name=\"faq questions list\">\n                    <details class=\"reveal group py-6\" data-kid=\"1-3-7-1-2-1\" data-name=\"question 1\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-8 font-display text-[21px] font-semibold text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-3-7-1-2-1-1\" data-name=\"summary\">\n                            <span data-kid=\"1-3-7-1-2-1-1-1\" data-name=\"question text\">\n                                Comment le locataire règle-t-il son loyer ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[20px] text-[#4338ca] group-open:rotate-45\" data-kid=\"1-3-7-1-2-1-1-2\" data-name=\"plus icon\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-3xl pt-4 text-[14px] leading-7 text-[#57534e]\" data-kid=\"1-3-7-1-2-1-2\" data-name=\"answer text\">\n                            Il reçoit une invitation sécurisée vers son portail, choisit MTN Mobile Money, Moov Money ou la carte bancaire, puis retrouve sa quittance dès la validation du paiement.\n                        </p>\n                    </details>\n                    <details class=\"reveal group py-6\" data-kid=\"1-3-7-1-2-2\" data-name=\"question 2\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-8 font-display text-[21px] font-semibold text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-3-7-1-2-2-1\" data-name=\"summary\">\n                            <span data-kid=\"1-3-7-1-2-2-1-1\" data-name=\"question text\">\n                                Les quittances sont-elles conformes au Bénin ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[20px] text-[#4338ca] group-open:rotate-45\" data-kid=\"1-3-7-1-2-2-1-2\" data-name=\"plus icon\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-3xl pt-4 text-[14px] leading-7 text-[#57534e]\" data-kid=\"1-3-7-1-2-2-2\" data-name=\"answer text\">\n                            Oui. Loka génère des documents lisibles, archivables et personnalisables avec le nom, le logo et les coordonnées de votre agence.\n                        </p>\n                    </details>\n                    <details class=\"reveal group py-6\" data-kid=\"1-3-7-1-2-3\" data-name=\"question 3\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-8 font-display text-[21px] font-semibold text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-3-7-1-2-3-1\" data-name=\"summary\">\n                            <span data-kid=\"1-3-7-1-2-3-1-1\" data-name=\"question text\">\n                                Puis-je gérer plusieurs propriétaires et équipes ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[20px] text-[#4338ca] group-open:rotate-45\" data-kid=\"1-3-7-1-2-3-1-2\" data-name=\"plus icon\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-3xl pt-4 text-[14px] leading-7 text-[#57534e]\" data-kid=\"1-3-7-1-2-3-2\" data-name=\"answer text\">\n                            Le plan Agence centralise vos biens, commissions, reversements et accès multi-utilisateurs pour garder une vision claire du portefeuille.\n                        </p>\n                    </details>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#312e81] px-5 py-16 text-white sm:px-8 lg:px-12 lg:py-20\" data-kid=\"1-4\" data-name=\"footer section\">\n        <div class=\"mx-auto max-w-7xl\" data-kid=\"1-4-1\" data-name=\"footer content\">\n            <div class=\"grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-8\" data-kid=\"1-4-1-1\" data-name=\"footer grid\">\n                <div data-kid=\"1-4-1-1-1\" data-name=\"branding column\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-1-1-1\" data-name=\"logo wrapper\">\n                        <div class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-white\" data-kid=\"1-4-1-1-1-1-1\" data-name=\"image container\">\n                            <img alt=\"Logo Loka\" class=\"h-10 w-10 rounded-lg object-contain\" data-kid=\"1-4-1-1-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\"/>\n                        </div>\n                        <div data-kid=\"1-4-1-1-1-1-2\" data-name=\"brand name block\">\n                            <p class=\"font-display text-[22px] font-semibold\" data-kid=\"1-4-1-1-1-1-2-1\" data-name=\"title\">\n                                Loka\n                            </p>\n                            <p class=\"text-[10px] uppercase tracking-[0.16em] text-[#c7d2fe]\" data-kid=\"1-4-1-1-1-1-2-2\" data-name=\"subtitle\">\n                                Gestion locative\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-6 max-w-xs text-[13px] leading-6 text-[#c7d2fe]\" data-kid=\"1-4-1-1-1-2\" data-name=\"description\">\n                        La gestion locative pensée pour les réalités du Bénin — de Cotonou à Porto-Novo.\n                    </p>\n                    <p class=\"mt-5 text-[12px] font-semibold text-[#f6e1d6]\" data-kid=\"1-4-1-1-1-3\" data-name=\"location text\">\n                        Cotonou · Calavi · Porto-Novo\n                    </p>\n                </div>\n                <div data-kid=\"1-4-1-1-2\" data-name=\"product links col\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[#f6e1d6]\" data-kid=\"1-4-1-1-2-1\" data-name=\"column title\">\n                        Produit\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[13px] text-[#e0e7ff]\" data-kid=\"1-4-1-1-2-2\" data-name=\"links list\">\n                        <li data-kid=\"1-4-1-1-2-2-1\" data-name=\"link 1\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-2-2-1-1\" data-name=\"anchor\" href=\"#fonctionnalites\">\n                                Fonctionnalités\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-2\" data-name=\"link 2\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-2-2-2-1\" data-name=\"anchor\" href=\"#tarifs\">\n                                Tarifs\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-3\" data-name=\"link 3\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-2-2-3-1\" data-name=\"anchor\" href=\"#portail-locataire\">\n                                Portail locataire\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-4-1-1-3\" data-name=\"about links col\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[#f6e1d6]\" data-kid=\"1-4-1-1-3-1\" data-name=\"column title\">\n                        À propos\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[13px] text-[#e0e7ff]\" data-kid=\"1-4-1-1-3-2\" data-name=\"links list\">\n                        <li data-kid=\"1-4-1-1-3-2-1\" data-name=\"link 1\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-3-2-1-1\" data-name=\"anchor\" href=\"/a-propos\">\n                                Notre histoire\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-3-2-2\" data-name=\"link 2\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-3-2-2-1\" data-name=\"anchor\" href=\"/contact\">\n                                Contact & support\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-4-1-1-4\" data-name=\"legal links col\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[#f6e1d6]\" data-kid=\"1-4-1-1-4-1\" data-name=\"column title\">\n                        Légal\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[13px] text-[#e0e7ff]\" data-kid=\"1-4-1-1-4-2\" data-name=\"links list\">\n                        <li data-kid=\"1-4-1-1-4-2-1\" data-name=\"link 1\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-4-2-1-1\" data-name=\"anchor\" href=\"/cgu\">\n                                CGU & mentions\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-4-2-2\" data-name=\"link 2\">\n                            <a class=\"min-h-11 inline-flex items-center hover:text-[#f6e1d6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f6e1d6]\" data-kid=\"1-4-1-1-4-2-2-1\" data-name=\"anchor\" href=\"/confidentialite\">\n                                Confidentialité\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-14 border-t border-white/15 pt-6 text-[11px] text-[#c7d2fe]\" data-kid=\"1-4-1-2\" data-name=\"footer bottom block\">\n                <div class=\"flex flex-col justify-between gap-3 sm:flex-row\" data-kid=\"1-4-1-2-1\" data-name=\"flex wrapper\">\n                    <span data-kid=\"1-4-1-2-1-1\" data-name=\"copyright text\">\n                        © 2026 Loka Technologies. Tous droits réservés.\n                    </span>\n                    <span class=\"text-[#f6e1d6]\" data-kid=\"1-4-1-2-1-2\" data-name=\"slogan text\">\n                        Une gestion plus simple, un quotidien plus léger.\n                    </span>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', function () {\n      const nav = document.querySelector('[data-nav]');\n      const progressLine = document.querySelector('.progress-line');\n      const mm = gsap.matchMedia();\n\n      window.addEventListener('scroll', function () {\n        if (nav) nav.classList.toggle('is-scrolled', window.scrollY > 12);\n      }, { passive: true });\n\n      gsap.to(progressLine, { scaleX: 1, ease: 'none', scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: true } });\n\n      mm.add({ reduceMotion: '(prefers-reduced-motion: reduce)' }, function (context) {\n        const reduceMotion = context.conditions.reduceMotion;\n        if (reduceMotion) {\n          gsap.set('.hero-kicker, .hero-title, .hero-copy, .hero-actions, .hero-proof, .hero-piece, .reveal, .story, .pricing-card', { autoAlpha: 1, x: 0, y: 0, scale: 1, clearProps: 'all' });\n          return;\n        }\n\n        gsap.timeline({ defaults: { ease: 'power3.out' } })\n          .from('.hero-kicker', { autoAlpha: 0, y: 16, duration: 0.6 })\n          .from('.hero-title', { autoAlpha: 0, y: 22, duration: 0.9 }, '-=0.32')\n          .from('.hero-copy', { autoAlpha: 0, y: 18, duration: 0.65 }, '-=0.48')\n          .from('.hero-actions', { autoAlpha: 0, y: 16, duration: 0.55 }, '-=0.35')\n          .from('.hero-proof', { autoAlpha: 0, y: 12, duration: 0.45 }, '-=0.28')\n          .from('.hero-float-a', { autoAlpha: 0, x: 28, y: 28, rotation: 0, duration: 0.9 }, '-=0.55')\n          .from('.hero-float-b', { autoAlpha: 0, x: 34, y: 26, rotation: 0, duration: 0.75 }, '-=0.58')\n          .from('.hero-piece:nth-of-type(3)', { autoAlpha: 0, x: -18, y: 18, duration: 0.55 }, '-=0.36');\n\n        gsap.to('.hero-float-a', { y: -8, duration: 3.6, ease: 'sine.inOut', repeat: -1, yoyo: true });\n        gsap.to('.hero-float-b', { y: 7, duration: 4.2, ease: 'sine.inOut', repeat: -1, yoyo: true, delay: 0.4 });\n\n        gsap.utils.toArray('.reveal').forEach(function (element) {\n          gsap.from(element, { autoAlpha: 0, y: 24, duration: 0.72, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 84%', once: true } });\n        });\n        gsap.utils.toArray('.story').forEach(function (element, index) {\n          gsap.from(element, { autoAlpha: 0, x: index % 2 === 0 ? -26 : 26, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 82%', once: true } });\n        });\n        gsap.from('.pricing-card', { autoAlpha: 0, y: 28, duration: 0.72, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '#tarifs', start: 'top 78%', once: true } });\n      });\n\n      document.querySelectorAll('[data-cta]').forEach(function (button) {\n        const arrow = button.querySelector('.cta-arrow');\n        if (!arrow) return;\n        const nudge = gsap.to(arrow, { x: 4, duration: 0.22, ease: 'power2.out', paused: true });\n        button.addEventListener('pointerenter', function () { nudge.play(); });\n        button.addEventListener('pointerleave', function () { nudge.reverse(); });\n      });\n\n      const homes = document.querySelector('#homes');\n      const homesOutput = document.querySelector('#homes-output');\n      const hoursOutput = document.querySelector('#hours-output');\n      if (homes && homesOutput && hoursOutput) {\n        homes.addEventListener('input', function (event) {\n          const count = Number(event.target.value);\n          homesOutput.textContent = count + ' logements';\n          hoursOutput.textContent = Math.max(1, Math.round(count * 0.8)) + ' h';\n        });\n      }\n    });\n    </script>\n</div>\n",
