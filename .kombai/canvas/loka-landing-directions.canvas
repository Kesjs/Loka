      "html": "<link data-kid=\"1\" href=\"https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css\" rel=\"stylesheet\"/>\n<style>\n    .loka-fusion{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;--ink:#111827;--muted:#64748b;--line:#e2e8f0;--wash:#f8fafc;--blue:#3730a3;--blue-soft:#eef2ff;--sky-line:#dbeafe;--warm:#d67a52;background:#fff;color:var(--ink)}\n  .loka-fusion .nav-scrolled{box-shadow:0 12px 34px rgba(15,23,42,.08);border-color:#cbd5e1}\n  .loka-fusion summary::-webkit-details-marker{display:none}\n  .loka-fusion details[open] .faq-plus{transform:rotate(45deg)}\n  .loka-fusion .reveal,.loka-fusion .hero-card{will-change:transform,opacity}\n  .loka-fusion .ph{display:inline-flex;align-items:center;justify-content:center;line-height:1}\n  @media (prefers-reduced-motion:reduce){.loka-fusion{scroll-behavior:auto}.loka-fusion .reveal,.loka-fusion .hero-card{will-change:auto}}\n</style>\n<div class=\"loka-fusion min-h-screen overflow-x-hidden bg-white text-slate-900 selection:bg-indigo-100 selection:text-indigo-950\" data-kid=\"2\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none fixed inset-x-0 top-0 z-[70] h-1 origin-left scale-x-0 bg-indigo-700\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"reading progress bar\" data-reason=\"width updated on scroll by GSAP\" id=\"fusion-progress\">\n    </div>\n    <header class=\"fixed inset-x-0 top-0 z-50 border-b border-transparent bg-white/95 backdrop-blur-md\" data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"navigation header\" data-reason=\"shadow and border toggled by scroll script\" id=\"fusion-nav\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-[1240px] items-center justify-between gap-8 px-6 lg:px-10\" data-kid=\"2-2-1\">\n            <a aria-label=\"Loka, retour à l'accueil\" class=\"flex min-h-11 items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-2-1-1\" href=\"#accueil\">\n                <span class=\"flex h-12 w-12 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white\" data-kid=\"2-2-1-1-1\">\n                    <img alt=\"Logo Loka\" class=\"h-full w-full object-contain\" data-kid=\"2-2-1-1-1-1\" decoding=\"async\" height=\"48\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\" width=\"48\"/>\n                </span>\n                <span class=\"hidden leading-tight sm:block\" data-kid=\"2-2-1-1-2\">\n                    <strong class=\"block text-[17px] font-extrabold tracking-[-0.04em] text-slate-950\" data-kid=\"2-2-1-1-2-1\">\n                        Loka\n                    </strong>\n                    <span class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-2-1-1-2-2\">\n                        Gestion locative\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Navigation principale\" class=\"hidden items-center gap-8 text-[13px] font-semibold text-slate-600 lg:flex\" data-kid=\"2-2-1-2\">\n                <a class=\"min-h-11 rounded-lg px-2 py-3 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-2-1-2-1\" href=\"#preuve\">\n                    La preuve\n                </a>\n                <a class=\"min-h-11 rounded-lg px-2 py-3 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-2-1-2-2\" href=\"#fonctionnalites\">\n                    Fonctionnalités\n                </a>\n                <a class=\"min-h-11 rounded-lg px-2 py-3 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-2-1-2-3\" href=\"#tarifs\">\n                    Tarifs\n                </a>\n                <a class=\"min-h-11 rounded-lg px-2 py-3 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-2-1-2-4\" href=\"#faq\">\n                    FAQ\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-3\">\n                <a class=\"hidden min-h-11 items-center rounded-lg px-3 py-3 text-[13px] font-semibold text-slate-600 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 sm:inline-flex\" data-kid=\"2-2-1-3-1\" href=\"#connexion\">\n                    Connexion\n                </a>\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-indigo-700 px-5 py-3 text-[13px] font-bold text-white shadow-sm shadow-indigo-700/20 hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-2-1-3-2\" href=\"#demarrer\">\n                    Commencer gratuitement\n                    <i aria-hidden=\"true\" class=\"ph ph-arrow-up-right text-[16px]\" data-kid=\"2-2-1-3-2-1\" style=\"color:#fff;width:16px;height:16px\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main class=\"pt-[76px]\" data-kid=\"2-3\" id=\"accueil\">\n        <section aria-labelledby=\"fusion-hero-title\" class=\"relative mx-auto max-w-[1240px] px-6 pb-24 pt-20 lg:px-10 lg:pb-32 lg:pt-28\" data-kid=\"2-3-1\">\n            <div class=\"grid items-center gap-16 lg:grid-cols-[5fr_7fr] lg:gap-10\" data-kid=\"2-3-1-1\">\n                <div class=\"reveal max-w-[560px]\" data-kid=\"2-3-1-1-1\">\n                    <p class=\"mb-7 inline-flex items-center gap-2 rounded-full border border-[#f0d8cb] bg-[#fff9f5] px-3.5 py-2 text-[11px] font-extrabold uppercase tracking-[0.16em] text-[#8e4b36]\" data-kid=\"2-3-1-1-1-1\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#d67a52]\" data-kid=\"2-3-1-1-1-1-1\">\n                        </s