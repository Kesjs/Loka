               </div>\n                        <a class=\"mt-8 flex min-h-12 items-center justify-center rounded-xl bg-indigo-600 text-sm font-bold text-white hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200\" data-kid=\"1-3-6-1-2-2-3\" href=\"/login?tab=signup\">\n                            Essai gratuit 14 jours\n                        </a>\n                    </article>\n                    <article class=\"reveal flex flex-col rounded-[22px] border border-slate-200 bg-white p-7 shadow-sm sm:p-8\" data-kid=\"1-3-6-1-2-3\">\n                        <div data-kid=\"1-3-6-1-2-3-1\">\n                            <span class=\"inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-extrabold text-slate-600\" data-kid=\"1-3-6-1-2-3-1-1\">\n                                Agence\n                            </span>\n                            <h3 class=\"mt-6 text-3xl font-extrabold tracking-[-0.05em] text-[#172033]\" data-kid=\"1-3-6-1-2-3-1-2\">\n                                29.900\n                                <span class=\"text-base font-bold tracking-normal text-slate-500\" data-kid=\"1-3-6-1-2-3-1-2-1\">\n                                    FCFA / mois\n                                </span>\n                            </h3>\n                            <p class=\"mt-2 text-sm text-slate-500\" data-kid=\"1-3-6-1-2-3-1-3\">\n                                Pour les gestionnaires et agences.\n                            </p>\n                            <div class=\"my-7 h-px bg-slate-200\" data-kid=\"1-3-6-1-2-3-1-4\">\n                            </div>\n                            <ul class=\"space-y-4 text-sm text-slate-600\" data-kid=\"1-3-6-1-2-3-1-5\">\n                                <li class=\"flex gap-3\" data-kid=\"1-3-6-1-2-3-1-5-1\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[18px]\" data-kid=\"1-3-6-1-2-3-1-5-1-1\" style=\"color:#4f46e5;width:18px;height:18px\">\n                                    </i>\n                                    Logements illimités\n                                </li>\n                                <li class=\"flex gap-3\" data-kid=\"1-3-6-1-2-3-1-5-2\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[18px]\" data-kid=\"1-3-6-1-2-3-1-5-2-1\" style=\"color:#4f46e5;width:18px;height:18px\">\n                                    </i>\n                                    Marque blanche complète\n                                </li>\n                                <li class=\"flex gap-3\" data-kid=\"1-3-6-1-2-3-1-5-3\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[18px]\" data-kid=\"1-3-6-1-2-3-1-5-3-1\" style=\"color:#4f46e5;width:18px;height:18px\">\n                                    </i>\n                                    Calcul des commissions\n                                </li>\n                                <li class=\"flex gap-3\" data-kid=\"1-3-6-1-2-3-1-5-4\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-check text-[18px]\" data-kid=\"1-3-6-1-2-3-1-5-4-1\" style=\"color:#4f46e5;width:18px;height:18px\">\n                                    </i>\n                                    Accès multi-utilisateurs\n                                </li>\n                            </ul>\n                        </div>\n                        <a class=\"mt-8 flex min-h-12 items-center justify-center rounded-xl border border-slate-300 text-sm font-bold text-[#172033] hover:border-indigo-400 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-6-1-2-3-2\" href=\"/login?tab=signup\">\n                            Parler à Loka\n                        </a>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white px-5 py-24 sm:px-8 lg:px-10 lg:py-28\" data-kid=\"1-3-7\" id=\"faq\">\n            <div class=\"mx-auto grid max-w-5xl gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20\" data-kid=\"1-3-7-1\">\n                <div class=\"reveal\" data-kid=\"1-3-7-1-1\">\n                    <p class=\"text-sm font-extrabold text-indigo-600\" data-kid=\"1-3-7-1-1-1\">\n                        Questions fréquentes\n                    </p>\n                    <h2 class=\"mt-4 text-3xl font-extrabold tracking-[-0.045em] text-[#172033] sm:text-5xl\" data-kid=\"1-3-7-1-1-2\">\n                        Tout ce qu'il faut savoir avant de commencer.\n                    </h2>\n                    <p class=\"mt-5 text-base leading-8 text-slate-600\" data-kid=\"1-3-7-1-1-3\">\n                        Une réponse manque ? Notre équipe peut vous accompagner dans la mise en place de votre portefeuille.\n                    </p>\n                    <a class=\"mt-7 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-indigo-700 hover:text-indigo-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-7-1-1-4\" href=\"/contact\">\n                        Contacter le support\n                        <i aria-hidden=\"true\" class=\"ph ph-arrow-right text-[17px]\" data-kid=\"1-3-7-1-1-4-1\" style=\"color:#4f46e5;width:17px;height:17px\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"reveal divide-y divide-slate-200 border-y border-slate-200\" data-kid=\"1-3-7-1-2\">\n                    <details class=\"group py-5\" data-kid=\"1-3-7-1-2-1\" data-name=\"faq question item\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-extrabold text-[#172033] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-7-1-2-1-1\" data-name=\"faq question summary\">\n                            <span data-kid=\"1-3-7-1-2-1-1-1\" data-name=\"faq question text\">\n                                Comment le locataire règle-t-il son loyer ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[19px] text-slate-500 group-open:rotate-45\" data-kid=\"1-3-7-1-2-1-1-2\" data-name=\"faq question icon\" style=\"color:#64748b;width:19px;height:19px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[620px] pt-4 text-sm leading-7 text-slate-600\" data-kid=\"1-3-7-1-2-1-2\">\n                            Le locataire reçoit une invitation sécurisée vers son portail. Il peut payer par MTN Mobile Money, Moov Money ou carte bancaire. La quittance est préparée après validation.\n                        </p>\n                    </details>\n                    <details class=\"group py-5\" data-kid=\"1-3-7-1-2-2\" data-name=\"faq question item\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-extrabold text-[#172033] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-7-1-2-2-1\" data-name=\"faq question summary\">\n                            <span data-kid=\"1-3-7-1-2-2-1-1\" data-name=\"faq question text\">\n                                Les quittances sont-elles conformes au Bénin ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[19px] text-slate-500 group-open:rotate-45\" data-kid=\"1-3-7-1-2-2-1-2\" data-name=\"faq question icon\" style=\"color:#64748b;width:19px;height:19px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[620px] pt-4 text-sm leading-7 text-slate-600\" data-kid=\"1-3-7-1-2-2-2\">\n                            Loka génère des documents structurés et personnalisables pour votre gestion. Vérifiez toujours vos mentions obligatoires avec votre conseil selon votre situation.\n                        </p>\n                    </details>\n                    <details class=\"group py-5\" data-kid=\"1-3-7-1-2-3\" data-name=\"faq question item\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-extrabold text-[#172033] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-7-1-2-3-1\" data-name=\"faq question summary\">\n                            <span data-kid=\"1-3-7-1-2-3-1-1\" data-name=\"faq question text\">\n                                Puis-je utiliser mon logo et le nom de mon agence ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[19px] text-slate-500 group-open:rotate-45\" data-kid=\"1-3-7-1-2-3-1-2\" data-name=\"faq question icon\" style=\"color:#64748b;width:19px;height:19px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[620px] pt-4 text-sm leading-7 text-slate-600\" data-kid=\"1-3-7-1-2-3-2\">\n                            Oui. Les plans Pro et Agence permettent de personnaliser votre en-tête, votre logo et les coordonnées affichées sur vos quittances.\n                        </p>\n                    </details>\n                    <details class=\"group py-5\" data-kid=\"1-3-7-1-2-4\" data-name=\"faq question item\">\n                        <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-left text-sm font-extrabold text-[#172033] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-7-1-2-4-1\" data-name=\"faq question summary\">\n                            <span data-kid=\"1-3-7-1-2-4-1-1\" data-name=\"faq question text\">\n                                Combien de temps faut-il pour démarrer ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[19px] text-slate-500 group-open:rotate-45\" data-kid=\"1-3-7-1-2-4-1-2\" data-name=\"faq question icon\" style=\"color:#64748b;width:19px;height:19px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[620px] pt-4 text-sm leading-7 text-slate-600\" data-kid=\"1-3-7-1-2-4-2\">\n                            Quelques minutes suffisent pour créer votre compte et ajouter votre premier logement. Vous pouvez ensuite inviter vos locataires progressivement.\n                        </p>\n                    </details>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-indigo-50 px-5 py-20 sm:px-8 lg:px-10 lg:py-24\" data-kid=\"1-3-8\">\n            <div class=\"reveal mx-auto flex max-w-5xl flex-col items-start justify-between gap-8 rounded-[24px] bg-white p-7 shadow-[0_24px_60px_-42px_rgba(79,70,229,0.55)] sm:p-10 lg:flex-row lg:items-center\" data-kid=\"1-3-8-1\">\n                <div data-kid=\"1-3-8-1-1\">\n                    <p class=\"text-sm font-extrabold text-indigo-600\" data-kid=\"1-3-8-1-1-1\">\n                        Prêt à simplifier votre gestion ?\n                    </p>\n                    <h2 class=\"mt-3 text-3xl font-extrabold tracking-[-0.045em] text-[#172033]\" data-kid=\"1-3-8-1-1-2\">\n                        Votre prochain encaissement peut déjà être plus simple.\n                    </h2>\n                    <p class=\"mt-3 max-w-[620px] text-sm leading-7 text-slate-600\" data-kid=\"1-3-8-1-1-3\">\n                        Créez votre espace Loka et testez le parcours pendant 14 jours, sans engagement.\n                    </p>\n                </div>\n                <a class=\"group flex min-h-12 shrink-0 items-center gap-2 rounded-xl bg-indigo-600 px-5 text-sm font-bold text-white hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200\" data-kid=\"1-3-8-1-2\" data-name=\"footer call-to-action button\" href=\"/login?tab=signup\">\n                    <span data-kid=\"1-3-8-1-2-1\">\n                        Commencer maintenant\n                    </span>\n                    <i aria-hidden=\"true\" class=\"arrow-nudge ph ph-arrow-right text-[18px]\" data-kid=\"1-3-8-1-2-2\" data-name=\"footer arrow icon\" style=\"color:#fff;width:18px;height:18px\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-slate-50 px-5 py-14 sm:px-8 lg:px-10\" data-kid=\"1-4\">\n        <div class=\"mx-auto max-w-7xl\" data-kid=\"1-4-1\">\n            <div class=\"grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]\" data-kid=\"1-4-1-1\">\n                <div data-kid=\"1-4-1-1-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-1-1-1\">\n                        <img alt=\"Logo Loka\" class=\"h-10 w-10 rounded-xl border border-slate-200 bg-white object-contain p-1\" data-kid=\"1-4-1-1-1-1-1\" decoding=\"async\" height=\"40\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\" width=\"40\"/>\n                        <span class=\"text-lg font-extrabold tracking-[-0.03em] text-[#172033]\" data-kid=\"1-4-1-1-1-1-2\">\n                            Loka\n                        </span>\n                    </div>\n                    <p class=\"mt-4 max-w-[280px] text-sm leading-7 text-slate-500\" data-kid=\"1-4-1-1-1-2\">\n                        La plateforme de gestion locative pensée pour les propriétaires, gestionnaires et locataires au Bénin.\n                    </p>\n                    <p class=\"mt-4 text-xs font-semibold text-slate-400\" data-kid=\"1-4-1-1-1-3\">\n                        Cotonou · Calavi · Porto-Novo\n                    </p>\n                </div>\n                <div data-kid=\"1-4-1-1-2\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[0.14em] text-slate-500\" data-kid=\"1-4-1-1-2-1\">\n                        Produit\n                    </p>\n                    <ul class=\"mt-4 space-y-3 text-sm text-slate-600\" data-kid=\"1-4-1-1-2-2\">\n                        <li data-kid=\"1-4-1-1-2-2-1\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-2-2-1-1\" href=\"#fonctionnalites\">\n                                Fonctionnalités\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-2\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-2-2-2-1\" href=\"#portail-locataire\">\n                                Portail locataire\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-3\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-2-2-3-1\" href=\"#tarifs\">\n                                Tarifs\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-4-1-1-3\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[0.14em] text-slate-500\" data-kid=\"1-4-1-1-3-1\">\n                        Loka\n                    </p>\n                    <ul class=\"mt-4 space-y-3 text-sm text-slate-600\" data-kid=\"1-4-1-1-3-2\">\n                        <li data-kid=\"1-4-1-1-3-2-1\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-3-2-1-1\" href=\"/a-propos\">\n                                À propos\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-3-2-2\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-3-2-2-1\" href=\"/contact\">\n                                Contact & support\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-3-2-3\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-3-2-3-1\" href=\"#faq\">\n                                FAQ\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-4-1-1-4\">\n                    <p class=\"text-xs font-extrabold uppercase tracking-[0.14em] text-slate-500\" data-kid=\"1-4-1-1-4-1\">\n                        Légal\n                    </p>\n                    <ul class=\"mt-4 space-y-3 text-sm text-slate-600\" data-kid=\"1-4-1-1-4-2\">\n                        <li data-kid=\"1-4-1-1-4-2-1\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-4-2-1-1\" href=\"/cgu\">\n                                CGU & mentions légales\n                            </a>\n                        </li>\n                        <li data-kid=\"1-4-1-1-4-2-2\">\n                            <a class=\"hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-4-1-1-4-2-2-1\" href=\"/confidentialite\">\n                                Confidentialité\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-12 border-t border-slate-200 pt-6 text-xs text-slate-400\" data-kid=\"1-4-1-2\">\n                <p data-kid=\"1-4-1-2-1\">\n                    © 2026 Loka Technologies. Gestion locative et encaissement Mobile Money au Bénin.\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script>\n    const motion = gsap.matchMedia();\n  motion.add({ reduceMotion: '(prefers-reduced-motion: reduce)', desktop: '(min-width: 1024px)' }, (context) => {\n    const { reduceMotion, desktop } = context.conditions;\n    if (reduceMotion) {\n      gsap.set('.reveal', { autoAlpha: 1, y: 0, clearProps: 'transform,opacity,visibility' });\n      gsap.set('.dashboard-float', { y: 0, x: 0, rotation: 0 });\n      return;\n    }\n\n    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n    intro.from('.reveal', { autoAlpha: 0, y: 22, duration: 0.7, stagger: 0.08, clearProps: 'all' });\n\n    gsap.utils.toArray('.reveal').forEach((element) => {\n      gsap.from(element, {\n        autoAlpha: 0,\n        y: 28,\n        duration: 0.65,\n        ease: 'power3.out',\n        clearProps: 'transform,opacity,visibility',\n        scrollTrigger: { trigger: element, start: 'top 86%', once: true }\n      });\n    });\n\n    if (desktop) {\n      gsap.to('.dashboard-float', {\n        y: -14,\n        rotation: 0.15,\n        ease: 'none',\n        scrollTrigger: { trigger: '.dashboard-float', start: 'top bottom', end: 'bottom top', scrub: 0.8 }\n      });\n    }\n\n    gsap.to('#scroll-progress', {\n      scaleX: 1,\n      ease: 'none',\n      scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: true }\n    });\n  });\n\n  document.querySelectorAll('.arrow-nudge').forEach((arrow) => {\n    const nudge = gsap.to(arrow, { x: 4, duration: 0.22, ease: 'power2.out', paused: true });\n    arrow.closest('a')?.addEventListener('pointerenter', () => nudge.play());\n    arrow.closest('a')?.addEventListener('pointerleave', () => nudge.reverse());\n  });\n\n  window.addEventListener('scroll', () => {\n    document.querySelector('#site-nav')?.classList.toggle('shadow-[0_12px_30px_-22px_rgba(23,32,51,0.7)]', window.scrollY > 12);\n  }, { passive: true });\n</script>\n",
