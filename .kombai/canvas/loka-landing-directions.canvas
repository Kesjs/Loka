\"color:#3730a3;width:19px;height:19px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-slate-100\" data-kid=\"2-3-7-1-2-1-2-4\">\n                                <th class=\"px-6 py-5 font-semibold text-slate-700\" data-kid=\"2-3-7-1-2-1-2-4-1\">\n                                    Relances & portail locataire\n                                </th>\n                                <td class=\"border-l border-slate-100 px-6 py-5 text-slate-400\" data-kid=\"2-3-7-1-2-1-2-4-2\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-indigo-100 bg-indigo-50/30 px-6 py-5 text-indigo-700\" data-kid=\"2-3-7-1-2-1-2-4-3\">\n                                    <i aria-label=\"Inclus\" class=\"ph ph-check-circle text-[19px]\" data-kid=\"2-3-7-1-2-1-2-4-3-1\" style=\"color:#3730a3;width:19px;height:19px\">\n                                    </i>\n                                </td>\n                                <td class=\"border-l border-slate-100 px-6 py-5 text-indigo-700\" data-kid=\"2-3-7-1-2-1-2-4-4\">\n                                    <i aria-label=\"Inclus\" class=\"ph ph-check-circle text-[19px]\" data-kid=\"2-3-7-1-2-1-2-4-4-1\" style=\"color:#3730a3;width:19px;height:19px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"2-3-7-1-2-1-2-5\">\n                                <th class=\"px-6 py-6\" data-kid=\"2-3-7-1-2-1-2-5-1\">\n                                </th>\n                                <td class=\"border-l border-slate-100 px-6 py-6\" data-kid=\"2-3-7-1-2-1-2-5-2\">\n                                    <a class=\"inline-flex min-h-11 w-full items-center justify-center rounded-full bg-slate-100 px-4 py-3 text-[13px] font-bold text-slate-800 hover:bg-slate-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-7-1-2-1-2-5-2-1\" href=\"#demarrer\">\n                                        Commencer\n                                    </a>\n                                </td>\n                                <td class=\"border-l border-indigo-100 bg-indigo-50/30 px-6 py-6\" data-kid=\"2-3-7-1-2-1-2-5-3\">\n                                    <a class=\"inline-flex min-h-11 w-full items-center justify-center rounded-full bg-indigo-700 px-4 py-3 text-[13px] font-bold text-white hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-7-1-2-1-2-5-3-1\" href=\"#demarrer\">\n                                        Essai gratuit 14 jours\n                                    </a>\n                                </td>\n                                <td class=\"border-l border-slate-100 px-6 py-6\" data-kid=\"2-3-7-1-2-1-2-5-4\">\n                                    <a class=\"inline-flex min-h-11 w-full items-center justify-center rounded-full bg-slate-100 px-4 py-3 text-[13px] font-bold text-slate-800 hover:bg-slate-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-7-1-2-1-2-5-4-1\" href=\"#demarrer\">\n                                        Parler à Loka\n                                    </a>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"faq-title\" class=\"mx-auto grid max-w-[1240px] gap-16 px-6 py-28 lg:grid-cols-[.8fr_1.2fr] lg:px-10 lg:py-36\" data-kid=\"2-3-8\" id=\"faq\">\n            <div class=\"reveal lg:sticky lg:top-32 lg:self-start\" data-kid=\"2-3-8-1\">\n                <p class=\"text-[12px] font-extrabold uppercase tracking-[0.18em] text-indigo-700\" data-kid=\"2-3-8-1-1\">\n                    Questions fréquentes\n                </p>\n                <h2 class=\"mt-4 max-w-[400px] text-[clamp(2.8rem,4.4vw,3.75rem)] font-black leading-[1.02] tracking-[-0.075em] text-slate-950\" data-kid=\"2-3-8-1-2\" id=\"faq-title\">\n                    Tout ce qui compte avant de commencer.\n                </h2>\n                <p class=\"mt-6 max-w-[330px] text-[16px] leading-7 text-slate-600\" data-kid=\"2-3-8-1-3\">\n                    Une réponse courte. Et si votre cas est particulier, notre équipe est à portée de message.\n                </p>\n                <a class=\"mt-8 inline-flex min-h-11 items-center gap-2 text-[14px] font-extrabold text-indigo-700 underline decoration-indigo-200 decoration-2 underline-offset-4 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-8-1-4\" href=\"#contact\">\n                    Contacter l'équipe\n                    <i aria-hidden=\"true\" class=\"ph ph-arrow-up-right text-[16px]\" data-kid=\"2-3-8-1-4-1\" style=\"color:#3730a3;width:16px;height:16px\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"reveal divide-y divide-slate-200 border-t border-slate-200\" data-kid=\"2-3-8-2\">\n                <details class=\"group py-6\" data-kid=\"2-3-8-2-1\">\n                    <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 text-[18px] font-extrabold tracking-[-0.03em] text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-8-2-1-1\">\n                        <span data-kid=\"2-3-8-2-1-1-1\">\n                            Comment le locataire règle-t-il son loyer ?\n                        </span>\n                        <span class=\"faq-plus flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 text-indigo-700\" data-kid=\"2-3-8-2-1-1-2\">\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[17px]\" data-kid=\"2-3-8-2-1-1-2-1\" style=\"color:#3730a3;width:17px;height:17px\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[640px] pt-4 text-[16px] leading-7 text-slate-600\" data-kid=\"2-3-8-2-1-2\">\n                        Il reçoit une invitation sécurisée vers son portail, puis règle par MTN Mobile Money, Moov Money ou carte. Une fois le paiement validé, la quittance est générée.\n                    </p>\n                </details>\n                <details class=\"group border-b border-slate-200 py-6\" data-kid=\"2-3-8-2-2\">\n                    <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 text-[18px] font-extrabold tracking-[-0.03em] text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-8-2-2-1\">\n                        <span data-kid=\"2-3-8-2-2-1-1\">\n                            Les quittances sont-elles personnalisables ?\n                        </span>\n                        <span class=\"faq-plus flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 text-indigo-700\" data-kid=\"2-3-8-2-2-1-2\">\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[17px]\" data-kid=\"2-3-8-2-2-1-2-1\" style=\"color:#3730a3;width:17px;height:17px\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[640px] pt-4 text-[16px] leading-7 text-slate-600\" data-kid=\"2-3-8-2-2-2\">\n                        Oui. Votre nom, votre logo, votre en-tête et vos coordonnées apparaissent sur les documents envoyés à vos locataires.\n                    </p>\n                </details>\n                <details class=\"group border-b border-slate-200 py-6\" data-kid=\"2-3-8-2-3\">\n                    <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 text-[18px] font-extrabold tracking-[-0.03em] text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-8-2-3-1\">\n                        <span data-kid=\"2-3-8-2-3-1-1\">\n                            Loka convient-il aux agences ?\n                        </span>\n                        <span class=\"faq-plus flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 text-indigo-700\" data-kid=\"2-3-8-2-3-1-2\">\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[17px]\" data-kid=\"2-3-8-2-3-1-2-1\" style=\"color:#3730a3;width:17px;height:17px\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[640px] pt-4 text-[16px] leading-7 text-slate-600\" data-kid=\"2-3-8-2-3-2\">\n                        Oui. Le plan Agence ajoute les logements illimités, le calcul des commissions et les accès multi-utilisateurs pour votre équipe.\n                    </p>\n                </details>\n                <details class=\"group border-b border-slate-200 py-6\" data-kid=\"2-3-8-2-4\">\n                    <summary class=\"flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 text-[18px] font-extrabold tracking-[-0.03em] text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-8-2-4-1\">\n                        <span data-kid=\"2-3-8-2-4-1-1\">\n                            Puis-je utiliser mon propre logo ?\n                        </span>\n                        <span class=\"faq-plus flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-300 text-indigo-700\" data-kid=\"2-3-8-2-4-1-2\">\n                            <i aria-hidden=\"true\" class=\"ph ph-plus text-[17px]\" data-kid=\"2-3-8-2-4-1-2-1\" style=\"color:#3730a3;width:17px;height:17px\">\n                            </i>\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[640px] pt-4 text-[16px] leading-7 text-slate-600\" data-kid=\"2-3-8-2-4-2\">\n                        Oui. Le plan Pro et le plan Agence permettent d'afficher votre identité sur les quittances et les documents de votre espace.\n                    </p>\n                </details>\n            </div>\n        </section>\n        <section class=\"bg-indigo-50 px-6 py-12 lg:px-10\" data-kid=\"2-3-9\">\n            <div class=\"reveal mx-auto flex max-w-[1120px] flex-col items-start justify-between gap-6 rounded-[24px] bg-white px-7 py-8 shadow-[0_18px_55px_rgba(55,48,163,0.08)] sm:flex-row sm:items-center sm:px-10\" data-kid=\"2-3-9-1\">\n                <div data-kid=\"2-3-9-1-1\">\n                    <p class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-indigo-700\" data-kid=\"2-3-9-1-1-1\">\n                        Prêt à simplifier votre gestion ?\n                    </p>\n                    <h2 class=\"mt-3 text-[28px] font-black tracking-[-0.05em] text-slate-950\" data-kid=\"2-3-9-1-1-2\">\n                        Votre prochain encaissement peut déjà être plus simple.\n                    </h2>\n                    <p class=\"mt-2 text-[15px] text-slate-600\" data-kid=\"2-3-9-1-1-3\">\n                        Créez votre espace Loka et testez le parcours pendant 14 jours, sans engagement.\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-indigo-700 px-5 py-3 text-[13px] font-extrabold text-white hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-kid=\"2-3-9-1-2\" href=\"#demarrer\">\n                    Commencer maintenant\n                    <i aria-hidden=\"true\" class=\"ph ph-arrow-right text-[16px]\" data-kid=\"2-3-9-1-2-1\" style=\"color:#fff;width:16px;height:16px\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-slate-950 text-white\" data-kid=\"2-4\" id=\"contact\">\n        <div class=\"mx-auto max-w-[1240px] px-6 py-16 lg:px-10 lg:py-20\" data-kid=\"2-4-1\">\n            <div class=\"grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]\" data-kid=\"2-4-1-1\">\n                <div data-kid=\"2-4-1-1-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-4-1-1-1-1\">\n                        <span class=\"flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg bg-white\" data-kid=\"2-4-1-1-1-1-1\">\n                            <img alt=\"Logo Loka\" class=\"h-full w-full object-contain\" data-kid=\"2-4-1-1-1-1-1-1\" decoding=\"async\" height=\"44\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\" width=\"44\"/>\n                        </span>\n                        <span class=\"text-[21px] font-black tracking-[-0.05em]\" data-kid=\"2-4-1-1-1-1-2\">\n                            Loka\n                        </span>\n                    </div>\n                    <p class=\"mt-6 max-w-[300px] text-[15px] leading-7 text-slate-400\" data-kid=\"2-4-1-1-1-2\">\n                        La gestion locative qui laisse plus de place à vos biens, vos locataires et vos décisions.\n                    </p>\n                    <p class=\"mt-5 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-500\" data-kid=\"2-4-1-1-1-3\">\n                        🇧🇯 Cotonou · Calavi · Porto-Novo\n                    </p>\n                </div>\n                <div data-kid=\"2-4-1-1-2\">\n                    <p class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-4-1-1-2-1\">\n                        Produit\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[14px] text-slate-300\" data-kid=\"2-4-1-1-2-2\">\n                        <li data-kid=\"2-4-1-1-2-2-1\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-2-2-1-1\" href=\"#fonctionnalites\">\n                                Fonctionnalités\n                            </a>\n                        </li>\n                        <li data-kid=\"2-4-1-1-2-2-2\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-2-2-2-1\" href=\"#tarifs\">\n                                Tarifs\n                            </a>\n                        </li>\n                        <li data-kid=\"2-4-1-1-2-2-3\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-2-2-3-1\" href=\"#portail\">\n                                Portail locataire\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"2-4-1-1-3\">\n                    <p class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-4-1-1-3-1\">\n                        Entreprise\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[14px] text-slate-300\" data-kid=\"2-4-1-1-3-2\">\n                        <li data-kid=\"2-4-1-1-3-2-1\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-3-2-1-1\" href=\"#a-propos\">\n                                À propos\n                            </a>\n                        </li>\n                        <li data-kid=\"2-4-1-1-3-2-2\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-3-2-2-1\" href=\"#contact\">\n                                Contact & support\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"2-4-1-1-4\">\n                    <p class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-4-1-1-4-1\">\n                        Légal\n                    </p>\n                    <ul class=\"mt-5 space-y-3 text-[14px] text-slate-300\" data-kid=\"2-4-1-1-4-2\">\n                        <li data-kid=\"2-4-1-1-4-2-1\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-4-2-1-1\" href=\"#cgu\">\n                                CGU & mentions légales\n                            </a>\n                        </li>\n                        <li data-kid=\"2-4-1-1-4-2-2\">\n                            <a class=\"hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-300\" data-kid=\"2-4-1-1-4-2-2-1\" href=\"#confidentialite\">\n                                Confidentialité\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-16 flex flex-col justify-between gap-4 border-t border-slate-800 pt-6 text-[12px] text-slate-500 sm:flex-row\" data-kid=\"2-4-1-2\">\n                <p data-kid=\"2-4-1-2-1\">\n                    © 2026 Loka Technologies. La gestion locative au Bénin 🇧🇯.\n                </p>\n                <p data-kid=\"2-4-1-2-2\">\n                    Simple à utiliser. Sérieux à gérer.\n                </p>\n            </div>\n        </div>\n    </footer>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const nav = document.getElementById('fusion-nav');\n    const progress = document.getElementById('fusion-progress');\n    const updateScrollUI = () => {\n      nav.classList.toggle('nav-scrolled', window.scrollY > 12);\n      const max = document.documentElement.scrollHeight - window.innerHeight;\n      gsap.set(progress, { scaleX: max > 0 ? window.scrollY / max : 0 });\n    };\n    window.addEventListener('scroll', updateScrollUI, { passive: true });\n    updateScrollUI();\n    if (reduceMotion) {\n      gsap.set('.reveal,.hero-card', { autoAlpha: 1, x: 0, y: 0, scale: 1 });\n    } else {\n      gsap.timeline({ defaults: { ease: 'power3.out' } }).from('.reveal:first-child', { autoAlpha: 0, y: 24, duration: .7 }).from('#fusion-hero-title', { autoAlpha: 0, y: 20, duration: .7 }, '-=.42').from('.hero-card', { autoAlpha: 0, y: 24, scale: .97, duration: .65, stagger: .1 }, '-=.38');\n      gsap.utils.toArray('.reveal').forEach((el) => gsap.from(el, { autoAlpha: 0, y: 28, duration: .65, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 84%', toggleActions: 'play none none reverse' } }));\n      gsap.to('.hero-card:nth-of-type(1)', { y: -26, ease: 'none', scrollTrigger: { trigger: '.hero-card:nth-of-type(1)', start: 'top bottom', end: 'bottom top', scrub: .8 } });\n      gsap.to('.hero-card:nth-of-type(2)', { y: 16, ease: 'none', scrollTrigger: { trigger: '.hero-card:nth-of-type(2)', start: 'top bottom', end: 'bottom top', scrub: .8 } });\n      gsap.to('.hero-card:nth-of-type(3)', { y: -12, ease: 'none', scrollTrigger: { trigger: '.hero-card:nth-of-type(3)', start: 'top bottom', end: 'bottom top', scrub: .8 } });\n    }\n    </script>\n</div>\n",
