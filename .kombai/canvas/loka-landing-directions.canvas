size: calc(var(--tsqd-font-size) * 0.75); padding: calc(var(--tsqd-font-size) * 0.25) calc(var(--tsqd-font-size) * 0.5); display: flex; border-radius: calc(var(--tsqd-font-size) * 0.25); background-color: rgb(242, 244, 247); border: 1px solid rgb(208, 213, 221); align-items: center; gap: calc(var(--tsqd-font-size) * 0.5); font-weight: 500; line-height: calc(var(--tsqd-font-size) * 1); cursor: pointer; }\n.go2669091971:focus-visible { outline-offset: 2px; border-radius: calc(var(--tsqd-font-size) * 0.125); outline: rgb(24, 73, 169) solid 2px; }\n.go2669091971:hover { background-color: rgb(234, 236, 240); }\n.go2669091971:disabled { opacity: 0.6; cursor: not-allowed; }\n</style>\n</head>\n\n  <section aria-labelledby=\"hero-title\" class=\"relative mx-auto max-w-[1240px] scroll-mt-24 px-5 pb-20 pt-20 sm:px-6 lg:px-10 lg:pb-28 lg:pt-28\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute left-1/2 top-0 -z-10 h-[520px] w-[min(100%,980px)] -translate-x-1/2 rounded-full bg-primary-50/60 blur-3xl\">\n    </div>\n    <div class=\"grid items-center gap-14 lg:grid-cols-[5fr_7fr] lg:gap-10\">\n      <div class=\"max-w-[560px]\" style=\"opacity: 1; transform: none;\">\n        <p class=\"mb-7 inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50 px-3.5 py-2 text-[11px] font-extrabold uppercase tracking-[0.15em] text-accent-600\">\n          <span aria-hidden=\"true\" class=\"h-2 w-2 rounded-full bg-accent-500\">\n          </span>\n          Pour propriétaires & agences au Bénin 🇧🇯\n        </p>\n        <h1 id=\"hero-title\" class=\"max-w-[590px] text-[clamp(3.35rem,6vw,5rem)] font-black leading-[0.98] tracking-[-0.075em] text-neutral-950\">\n          Une gestion locative qui laisse \n          <span class=\"text-primary-800\">\n            respirer\n          </span>\n           votre activité.\n        </h1>\n        <p class=\"mt-8 max-w-[520px] text-lg leading-8 text-neutral-600\">\n          Encaissez par MTN MoMo, Moov Money ou carte, puis envoyez des quittances conformes et personnalisées — à Cotonou, Calavi comme à Porto-Novo.\n        </p>\n        <div class=\"mt-9 flex flex-col gap-3 sm:flex-row\">\n          <a href=\"/login?tab=signup\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors disabled:pointer-events-none disabled:opacity-50 text-white h-12 min-h-12 rounded-full bg-primary-800 px-6 text-sm font-bold shadow-lg shadow-primary-800/20 hover:bg-primary-900\">\n            Créer mon compte\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\">\n              <path d=\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\">\n              </path>\n            </svg>\n          </a>\n          <a href=\"#portail-locataire\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors disabled:pointer-events-none disabled:opacity-50 border h-12 min-h-12 rounded-full border-neutral-300 bg-white px-6 text-sm font-bold text-neutral-800 hover:border-primary-300 hover:bg-primary-50 hover:text-primary-800\">\n            Voir le portail locataire\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\">\n              <path d=\"M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z\">\n              </path>\n            </svg>\n          </a>\n        </div>\n        <div class=\"mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 text-xs font-semibold text-neutral-500\">\n          <span class=\"inline-flex items-center gap-2\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\" class=\"text-primary-800\">\n              <path d=\"M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z\">\n              </path>\n            </svg>\n            3 minutes pour démarrer\n          </span>\n          <span class=\"inline-flex items-center gap-2\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\" class=\"text-primary-800\">\n              <path d=\"M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z\">\n              </path>\n            </svg>\n            🇧🇯 Bénin · Cotonou · Calavi · Porto-Novo\n          </span>\n        </div>\n      </div>\n      <div class=\"min-w-0 lg:pt-3\" style=\"transform: none;\">\n        <div class=\"relative w-full overflow-hidden rounded-[28px] border border-neutral-200 bg-white p-4 shadow-[0_28px_80px_rgba(30,41,59,0.12)] sm:p-6 lg:p-7\" style=\"opacity: 1; transform: none;\">\n          <div aria-hidden=\"true\" class=\"pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-primary-50\">\n          </div>\n          <div class=\"relative\">\n            <div class=\"mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-neutral-100 pb-5\">\n              <div class=\"flex items-center gap-3\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary-50 text-primary-800\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\">\n                    <path d=\"M136,32V216H40V85.35a8,8,0,0,1,3.56-6.66l80-53.33A8,8,0,0,1,136,32Z\" opacity=\"0.2\">\n                    </path>\n                    <path d=\"M240,208H224V96a16,16,0,0,0-16-16H144V32a16,16,0,0,0-24.88-13.32L39.12,72A16,16,0,0,0,32,85.34V208H16a8,8,0,0,0,0,16H240a8,8,0,0,0,0-16ZM208,96V208H144V96ZM48,85.34,128,32V208H48ZM112,112v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm-32,0v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm0,56v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Zm32,0v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Z\">\n                    </path>\n                  </svg>\n                </span>\n                <div>\n                  <div class=\"flex flex-wrap items-center gap-2\">\n                    <span class=\"text-sm font-extrabold text-neutral-900\">\n                      Vue d'ensemble\n                    </span>\n                    <span class=\"rounded-full bg-primary-50 px-2.5 py-1 text-[10px] font-extrabold text-primary-800\">\n                      Portefeuille Bénin 🇧🇯\n                    </span>\n                  </div>\n                  <p class=\"text-xs text-neutral-500\">\n                    Votre activité locative, en un seul endroit.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div dir=\"ltr\" data-orientation=\"horizontal\" class=\"max-w-full\">\n              <div role=\"tablist\" aria-orientation=\"horizontal\" tabindex=\"0\" data-orientation=\"horizontal\" class=\"inline-flex h-10 items-center justify-center rounded-lg bg-gray-100 p-1 text-gray-600 h-11 max-w-full overflow-x-auto rounded-full border border-neutral-200 bg-neutral-50\" style=\"outline:none\">\n                <button type=\"button\" role=\"tab\" aria-selected=\"true\" aria-controls=\"radix-_R_al8bindlb_-content-vue_ensemble\" data-state=\"active\" id=\"radix-_R_al8bindlb_-trigger-vue_ensemble\" tabindex=\"-1\" data-orientation=\"horizontal\" data-radix-collection-item=\"\" class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium ring-offset-white transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-white data-[state=active]:text-gray-900 data-[state=active]:shadow-sm min-h-9 rounded-full text-[11px] font-bold text-neutral-500 data-[state=active]:text-neutral-900 sm:px-4\">\n                  Vue d'ensemble\n                </button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" aria-controls=\"radix-_R_al8bindlb_-content-reglements\" data-state=\"inactive\" id=\"radix-_R_al8bindlb_-trigger-reglements\" tabindex=\"-1\" data-orientation=\"horizontal\" data-radix-collection-item=\"\" class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium ring-offset-white transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-white data-[state=active]:text-gray-900 data-[state=active]:shadow-sm min-h-9 rounded-full text-[11px] font-bold text-neutral-500 data-[state=active]:text-neutral-900 sm:px-4\">\n                  Règlements récents\n                </button>\n              </div>\n              <div data-state=\"active\" data-orientation=\"horizontal\" role=\"tabpanel\" aria-labelledby=\"radix-_R_al8bindlb_-trigger-vue_ensemble\" id=\"radix-_R_al8bindlb_-content-vue_ensemble\" tabindex=\"0\" class=\"mt-2 ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 mt-0\">\n                <div class=\"space-y-5\">\n                  <div class=\"grid grid-cols-2 gap-3 lg:grid-cols-4\">\n                    <div class=\"rounded-2xl border border-neutral-100 p-4 bg-primary-50\" style=\"opacity: 1; transform: none;\">\n                      <div class=\"mb-3 flex items-center justify-between gap-2 text-neutral-500\">\n                        <span class=\"text-[11px] font-semibold leading-tight\">\n                          Loyers collectés\n                        </span>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\" class=\"text-primary-800\">\n                          <path d=\"M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm40-68a28,28,0,0,1-28,28h-4v8a8,8,0,0,1-16,0v-8H104a8,8,0,0,1,0-16h36a12,12,0,0,0,0-24H116a28,28,0,0,1,0-56h4V72a8,8,0,0,1,16,0v8h16a8,8,0,0,1,0,16H116a12,12,0,0,0,0,24h24A28,28,0,0,1,168,148Z\">\n                          </path>\n                        </svg>\n                      </div>\n                      <p class=\"text-lg font-black tracking-[-0.045em] text-neutral-900 sm:text-xl\">\n                        3 850 000 FCFA\n                      </p>\n                      <p class=\"mt-2 text-[10px] font-semibold text-primary-800\">\n                        +12% ce mois\n                      </p>\n                    </div>\n                    <div class=\"rounded-2xl border border-neutral-100 p-4 bg-neutral-50\" style=\"opacity: 1; transform: none;\">\n                      <div class=\"mb-3 flex items-center justify-between gap-2 text-neutral-500\">\n                        <span class=\"text-[11px] font-semibold leading-tight\">\n                          Taux d'occupation\n                        </span>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\" class=\"text-neutral-900\">\n                          <path d=\"M219.31,108.68l-80-80a16,16,0,0,0-22.62,0l-80,80A15.87,15.87,0,0,0,32,120v96a8,8,0,0