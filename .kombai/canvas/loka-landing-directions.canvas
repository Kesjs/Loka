      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n  @import url('https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css');\n  .font-body { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n  .font-display { font-family: 'Playfair Display', Georgia, serif; }\n  .nav-shell.is-scrolled { box-shadow: 0 12px 32px rgba(49,46,129,.10); border-bottom-color: rgba(49,46,129,.12); }\n  .soft-rule { background: rgba(120,113,108,.18); height: 1px; }\n  .paper-shadow { box-shadow: 0 24px 70px rgba(67,56,202,.13), 0 3px 14px rgba(41,37,36,.06); }\n  .receipt-shadow { box-shadow: 0 20px 55px rgba(214,122,82,.20), 0 3px 12px rgba(41,37,36,.08); }\n  .story-art { min-height: 320px; }\n  .no-transition { transition: none !important; }\n  @media (max-width: 767px) {\n    .story-art { min-height: 270px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n  }\n</style>\n<div class=\"font-body min-h-screen bg-[#fffdf9] text-[#312e2d] selection:bg-[#d67a52]/20 selection:text-[#312e2d]\" data-kid=\"1\" data-name=\"page background container\">\n    <div aria-hidden=\"true\" class=\"fixed inset-x-0 top-0 z-[60] h-1 origin-left scale-x-0 bg-[#d67a52] progress-line\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"scroll progress indicator\" data-reason=\"width scaled from 0 to 1 based on scroll position by GSAP\">\n    </div>\n    <header class=\"nav-shell sticky top-0 z-50 border-b border-[#e7e5e4] bg-white/95 backdrop-blur-xl\" data-kid=\"1-2\" data-name=\"navigation header shell\" data-nav=\"\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-7xl items-center justify-between gap-8 px-5 sm:px-8 lg:px-12\" data-kid=\"1-2-1\" data-name=\"navigation content container\">\n            <a aria-label=\"Loka, accueil\" class=\"flex min-h-11 items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-2-1-1\" data-name=\"logo and brand link\" href=\"#hero\">\n                <img alt=\"Logo Loka\" class=\"h-12 w-12 rounded-xl object-contain\" data-kid=\"1-2-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\"/>\n                <span class=\"hidden leading-tight sm:block\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    <span class=\"block text-[15px] font-bold tracking-[-0.02em] text-[#312e81]\" data-kid=\"1-2-1-1-2-1\" data-name=\"company name\">\n                        Loka\n                    </span>\n                    <span class=\"block text-[10px] font-semibold uppercase tracking-[0.16em] text-[#78716c]\" data-kid=\"1-2-1-1-2-2\" data-name=\"tagline text\">\n                        Gestion locative\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Navigation principale\" class=\"hidden items-center gap-8 text-[13px] font-medium text-[#57534e] lg:flex\" data-kid=\"1-2-1-2\" data-name=\"navigation links container\">\n                <a class=\"flex min-h-11 items-center rounded-lg px-1 hover:text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-2-1-2-1\" data-name=\"why loka nav link\" href=\"#methode\">\n                    Pourquoi Loka\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-lg px-1 hover:text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-2-1-2-2\" data-name=\"features nav link\" href=\"#fonctionnalites\">\n                    Fonctionnalités\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-lg px-1 hover:text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-2-1-2-3\" data-name=\"pricing nav link\" href=\"#tarifs\">\n                    Tarifs\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-lg px-1 hover:text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-2-1-2-4\" data-name=\"faq nav link\" href=\"#faq\">\n                    FAQ\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2 sm:gap-4\" data-kid=\"1-2-1-3\" data-name=\"authentication links container\">\n                <a class=\"hidden min-h-11 items-center rounded-lg px-3 text-[13px] font-semibold text-[#57534e] hover:text-[#312e81] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca] sm:flex\" data-kid=\"1-2-1-3-1\" data-name=\"login nav link\" href=\"/login\">\n                    Connexion\n                </a>\n                <a class=\"group inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[#d67a52] px-4 text-[13px] font-bold text-white shadow-[0_10px_24px_rgba(214,122,82,.20)] hover:bg-[#b85e3b] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#312e81] sm:px-5\" data-cta=\"\" data-kid=\"1-2-1-3-2\" data-name=\"get-started call-to-action button\" href=\"/login?tab=signup\">\n                    Essai gratuit\n                    <i aria-hidden=\"true\" class=\"ph ph-arrow-up-right cta-arrow text-[17px]\" data-kid=\"1-2-1-3-2-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-3\" data-name=\"main page content\">\n        <section class=\"relative overflow-hidden bg-[#fffdf9]\" data-kid=\"1-3-1\" data-name=\"hero section\" id=\"hero\">\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute -right-40 top-20 h-[520px] w-[520px] rounded-full bg-[#dbeafe]/45 blur-3xl\" data-kid=\"1-3-1-1\" data-name=\"hero background blur orb 1\">\n            </div>\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute -left-48 bottom-0 h-[420px] w-[420px] rounded-full bg-[#f6e1d6]/55 blur-3xl\" data-kid=\"1-3-1-2\" data-name=\"hero background blur orb 2\">\n            </div>\n            <div class=\"relative mx-auto grid max-w-7xl items-center gap-16 px-5 pb-20 pt-16 sm:px-8 sm:pt-20 lg:grid-cols-[.86fr_1.14fr] lg:gap-20 lg:px-12 lg:pb-28 lg:pt-24\" data-kid=\"1-3-1-3\" data-name=\"hero content grid\">\n                <div class=\"relative z-10 max-w-[590px]\" data-kid=\"1-3-1-3-1\" data-name=\"hero text content\">\n                    <div class=\"hero-kicker mb-6 inline-flex min-h-8 items-center gap-2 rounded-full border border-[#d67a52]/25 bg-[#f6e1d6]/45 px-3.5 text-[11px] font-bold uppercase tracking-[0.13em] text-[#9f4f31]\" data-kid=\"1-3-1-3-1-1\" data-name=\"hero kicker label\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#d67a52]\" data-kid=\"1-3-1-3-1-1-1\" data-name=\"kicker dot icon\">\n                        </span>\n                        Pour propriétaires & agences au Bénin\n                    </div>\n                    <h1 class=\"hero-title font-display text-[44px] font-semibold leading-[1.05] tracking-[-0.045em] text-[#312e81] sm:text-[54px] lg:text-[62px]\" data-kid=\"1-3-1-3-1-2\" data-name=\"hero headline\">\n                        Une gestion locative qui laisse\n                        <span class=\"text-[#d67a52]\" data-kid=\"1-3-1-3-1-2-1\" data-name=\"hero highlighted text\">\n                            respirer\n                        </span>\n                        votre activité.\n                    </h1>\n                    <p class=\"hero-copy mt-7 max-w-[530px] text-[16px] leading-8 text-[#57534e] sm:text-[18px]\" data-kid=\"1-3-1-3-1-3\" data-name=\"hero description copy\">\n                        Encaissez les loyers par MTN MoMo, Moov Money ou carte, puis envoyez des quittances conformes et personnalisées en quelques secondes — sans cahier à relire ni relance à improviser.\n                    </p>\n                    <div class=\"hero-actions mt-9 flex flex-col gap-3 sm:flex-row\" data-kid=\"1-3-1-3-1-4\" data-name=\"hero call-to-action buttons\">\n                        <a class=\"group inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#d67a52] px-6 text-[14px] font-bold text-white shadow-[0_16px_32px_rgba(214,122,82,.22)] hover:bg-[#b85e3b] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#312e81]\" data-cta=\"\" data-kid=\"1-3-1-3-1-4-1\" data-name=\"primary call-to-action button\" href=\"/login?tab=signup\">\n                            Créer mon compte gratuitement\n                            <i aria-hidden=\"true\" class=\"ph ph-arrow-right cta-arrow text-[18px]\" data-kid=\"1-3-1-3-1-4-1-1\" data-name=\"arrow-right icon\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex min-h-12 items-center justify-center gap-3 rounded-full border border-[#c7d2fe] bg-white px-6 text-[14px] font-bold text-[#312e81] shadow-[0_8px_20px_rgba(49,46,129,.06)] hover:border-[#4338ca] hover:bg-[#eef2ff] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4338ca]\" data-kid=\"1-3-1-3-1-4-2\" data-name=\"secondary call-to-action button\" href=\"#portail-locataire\">\n                            Voir le portail locataire\n                            <i aria-hidden=\"true\" class=\"ph ph-arrow-down-right text-[18px] text-[#4338ca]\" data-kid=\"1-3-1-3-1-4-2-1\" data-name=\"arrow-down-right icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"hero-proof mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 text-[12px] font-medium text-[#78716c]\" data-kid=\"1-3-1-3-1-5\" data-name=\"social proof container\">\n                        <div class=\"flex -space-x-2\" data-kid=\"1-3-1-3-1-5-1\" data-name=\"customer avatars stack\">\n                            <div class=\"flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#fffdf9] bg-[#312e81] text-[10px] font-bold text-white\" data-kid=\"1-3-1-3-1-5-1-1\" data-name=\"avatar 1\">\n                                KM\n                            </div>\n                            <div class=\"flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#fffdf9] bg-[#d67a52] text-[10px] font-bold text-white\" data-kid=\"1-3-1-3-1-5-1-2\" data-name=\"avatar 2\">\n                                AD\n                            </div>\n                            <div class=\"flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#fffdf9] bg-[#7c93b8] text-[10px] font-bold text-white\" data-kid=\"1-3-1-3-1-5-1-3\" data-name=\"avatar 3\">\n                                SG\n                            </div>\n                        </div>\n                        <span data-kid=\"1-3-1-3-1-5-2\" data-name=\"proof description text\">\n                            <strong class=\"text-[#312e81]\" data-kid=\"1-3-1-3-1-5-2-1\" data-name=\"proof count\">\n                                +500 bailleurs\n                            </strong>\n                            à Cotonou, Calavi et Porto-Novo\n                        </span>\n                    </div>\n                </div>\n                <div aria-label=\"Aperçu du tableau de bord Loka\" class=\"relative min-h-[510px] lg:min-h-[590px]\" data-kid=\"1-3-1-3-2\" data-name=\"hero visuals container\">\n                    <div class=\"hero-piece hero-float-a absolute left-0 top-12 w-[88%] rotate-[-3deg] rounded-[26px] border border-[#c7d2fe] bg-white p-5 paper-shadow sm:left-5 sm:w-[84%] sm:p-7\" data-kid=\"1-3-1-3-2-1\" data-name=\"floating dashboard card a\">\n                        <div class=\"flex items-center justify-between border-b border-[#e7e5e4] pb-5\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"card header\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-3-2-1-1-1\" data-name=\"card icon container\">\n                                <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#eef2ff] text-[#4338ca]\" data-kid=\"1-3-1-3-2-1-1-1-1\" data-name=\"building icon\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-buildings text-[21px]\" data-kid=\"1-3-1-3-2-1-1-1-1-1\" data-name=\"icon\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"1-3-1-3-2-1-1-1-2\" data-name=\"portfolio title\">\n                                    <p class=\"text-[13px] font-bold text-[#312e81]\" data-kid=\"1-3-1-3-2-1-1-1-2-1\" data-name=\"portfolio name\">\n                                        Loka · Portefeuille Bénin\n                                    </p>\n                                    <p class=\"mt-0.5 text-[11px] text-[#78716c]\" data-kid=\"1-3-1-3-2-1-1-1-2-2\" data-name=\"real-time status\">\n                                        Vue en temps réel\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"rounded-full bg-[#ecfdf5] px-2.5 py-1 text-[10px] font-bold text-[#15803d]\" data-kid=\"1-3-1-3-2-1-1-2\" data-name=\"sync status label\">\n                                Synchronisé\n                            </span>\n                        </div>\n                        <div class=\"mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4\" data-kid=\"1-3-1-3-2-1-2\" data-name=\"stats grid\">\n                            <div class=\"rounded-2xl bg-[#f8fafc] p-3\" data-kid=\"1-3-1-3-2-1-2-1\" data-name=\"stat 1 card\">\n                                <p class=\"text-[10px] font-medium text-[#78716c]\" data-kid=\"1-3-1-3-2-1-2-1-1\" data-name=\"stat 1 label\">\n                                    Loyers collectés\n                                </p>\n                                <p class=\"mt-2 text-[16px] font-bold text-[#312e81]\" data-kid=\"1-3-1-3-2-1-2-1-2\" data-name=\"stat 1 value\">\n                                    3,85 M\n                                </p>\n                                <p class=\"mt-1 text-[10px] font-semibold text-[#15803d]\" data-kid=\"1-3-1-3-2-1-2-1-3\" data-name=\"stat 1 trend\">\n                                    +12% ce mois\n                                </p>\n                            </div>\n                            <div class=\"rounded-2xl bg-[#f8fafc] p-3\" data-kid=\"1-3-1-3-2-1-2-2\" data-name=\"stat 2 card\">\n                                <p class=\"text-[10px] font-medium text-[#78716c]\" data-kid=\"1-3-1-3-2-1-2-2-1\" data-name=\"stat 2 label\">\n                                    Occupation\n                                </p>\n                                <p class=\"mt-2 text-[16px] font-bold text-[#312e81]\" data-kid=\"1-3-1-3-2-1-2-2-2\" data-name=\"stat 2 value\">\n                                    96%\n                                </p>\n                                <p class=\"mt-1 text-[10px] text-[#78716c]\" data-kid=\"1-3-1-3-2-1-2-2-3\" data-name=\"stat 2 sublabel\">\n                                    24 / 25 biens\n                                </p>\n                            </div>\n                            <div class=\"rounded-2xl bg-[#f8fafc] p-3\" data-kid=\"1-3-1-3-2-1-2-3\" data-name=\"stat 3 card\">\n                                <p class=\"text-[10px] font-medium text-[#78716c]\" data-kid=\"1-3-1-3-2-1-2-3-1\" data-name=\"stat 3 label\">\n                                    Mobile Money\n                                </p>\n                                <p class=\"mt-2 text-[16px] font-bold text-[#312e81]\" data-kid=\"1-3-1-3-2-1-2-3-2\" data-name=\"stat 3 value\">\n                                    78%\n                                </p>\n                                <p class=\"mt-1 text-[10px] text-[#78716c]\" data-kid=\"1-3-1-3-2-1-2-3-3\" data-name=\"stat 3 sublabel\">\n                                    MTN & Moov\n                                </p>\n                            </div>\n                            <div class=\"rounded-2xl bg-[#f8fafc] p-3\" data-kid=\"1-3-1-3-2-1-2-4\" data-name=\"stat 4 card\">\n                                <p class=\"text-[10px] font-medium text-[#78716c]\" data-kid=\"1-3-1-3-2-1-2-4-1\" data-name=\"stat 4 label\">\n                                    Quittances\n                                </p>\n                                <p class=\"mt-2 text-[16px] font-bold text-[#312e81]\" data-kid=\"1-3-1-3-2-1-2-4-2\" data-name=\"stat 4 value\">\n                                    100%\n                                </p>\n                                <p class=\"mt-1 text-[10px] font-semibold text-[#15803d]\" data-kid=\"1-3-1-3-2-1-2-4-3\" data-name=\"stat 4 trend\">\n                                    Archivées\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-4 rounded-2xl border border-[#e7e5e4] p-4\" data-kid=\"1-3-1-3-2-1-3\" data-name=\"transaction list container\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-3-2-1-3-1\" data-name=\"list header\">\n                                <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#78716c]\" data-kid=\"1-3-1-3-2-1-3-1-1\" data-name=\"list title\">\n                                    Derniers encaissements\n                                </p>\n                                <span class=\"flex items-center gap-1 text-[10px] font-semibold text-[#4338ca]\" data-kid=\"1-3-1-3-2-1-3-1-2\" data-name=\"live status\">\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#4338ca]\" data-kid=\"1-3-1-3-2-1-3-1-2-1\" data-name=\"live indicator\">\n                                    </span>\n                                    en direct\n                                </span>\n                            </div>\n                            <div class=\"mt-3 space-y-3 text-[11px]\" data-kid=\"1-3-1-3-2-1-3-2\" data-name=\"transaction list\">\n                                <div class=\"flex items-center justify-between border-b border-[#f0eeeb] pb-3\" data-kid=\"1-3-1-3-2-1-3-2-1\" data-name=\"transaction row 1\">\n                                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-1-3-2-1-3-2-1-1\" data-name=\"transaction user info\">\n                                        <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#eef2ff] text-[9px] font-bold text-[#4338ca]\" data-kid=\"1-3-1-3-2-1-3-2-1-1-1\" data-name=\"avatar icon\">\n                                            KM\n                                        </span>\n                                        <span data-kid=\"1-3-1-3-2-1-3-2-1-1-2\" data-name=\"transaction meta\">\n                                            <strong class=\"block text-[#312e81]\" data-kid=\"1-3-1-3-2-1-3-2-1-1-2-1\" data-name=\"transaction name\">\n                                                Koffi M.\n                                            </strong>\n                                            <small class=\"text-[#78716c]\" data-kid=\"1-3-1-3-2-1-3-2-1-1-2-2\" data-name=\"transaction description\">\n                                                Résidence Fidjrossè\n                                            </small>\n                                        </span>\n                                    </div>\n                                    <span class=\"text-right\" data-kid=\"1-3-1-3-2-1-3-2-1-2\" data-name=\"transaction value\">\n                                        <strong class=\"block text-[#312e81]\" data-kid=\"1-3-1-3-2-1-3-2-1-2-1\" data-name=\"amount text\">\n                                            150 000 FCFA\n                                        </strong>\n                                        <small class=\"text-[#15803d]\" data-kid=\"1-3-1-3-2-1-3-2-1-2-2\" data-name=\"payment method\">\n                                            MTN MoMo\n                                        </small>\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-3-2-1-3-2-2\" data-name=\"transaction row 2\">\n                                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-1-3-2-1-3-2-2-1\" data-name=\"transaction user info\">\n                                        <span class=\"flex h-7 w-7 items-center justify-center rounded-full bg-[#f6e1d6] text-[9px] font-bold text-[#9f4f31]\" data-kid=\"1-3-1-3-2-1-3-2-2-1-1\" data-name=\"avatar icon\">\n                                            DA\n                                        </span>\n                                        <span data-kid=\"1-3-1-3-2-1-3-2-2-1-2\" data-name=\"transaction meta\">\n                                            <strong class=\"block text-[#312e81]\" data-kid=\"1-3-1-3-2-1-3-2-2-1-2-1\" data-name=\"transaction name\">\n                                                Dossou A.\n                                            </strong>\n                                            <small class=\"text-[#78716c]\" data-kid=\"1-3-1-3-2-1-3-2-2-1-2-2\" data-name=\"transaction description\">\n                                                Immeuble Haie Vive\n                                            </small>\n                                        </span>\n                                    </div>\n                                    <span class=\"text-right\" data-kid=\"1-3-1-3-2-1-3-2-2-2\" data-name=\"transaction value\">\n                                        <strong class=\"block text-[#312e81]\" data-kid=\"1-