l max-w-[680px]\" data-kid=\"1-3-2-1-1\">\n                    <p class=\"text-sm font-extrabold text-indigo-600\" data-kid=\"1-3-2-1-1-1\">\n                        La gestion locative, sans les frictions\n                    </p>\n                    <h2 class=\"mt-4 text-3xl font-extrabold tracking-[-0.045em] text-[#172033] sm:text-5xl\" data-kid=\"1-3-2-1-1-2\">\n                        Passez du suivi dispersé à une routine claire.\n                    </h2>\n                    <p class=\"mt-5 text-base leading-8 text-slate-600\" data-kid=\"1-3-2-1-1-3\">\n                        Loka rassemble les moments qui comptent : encaisser, justifier, relancer et garder une vue fiable sur chaque logement.\n                    </p>\n                </div>\n                <div class=\"mt-12 grid gap-5 lg:grid-cols-2\" data-kid=\"1-3-2-1-2\">\n                    <div class=\"reveal rounded-[22px] bg-white p-7 shadow-sm ring-1 ring-slate-200/80 sm:p-9\" data-kid=\"1-3-2-1-2-1\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-2-1-1\">\n                            <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-slate-100\" data-kid=\"1-3-2-1-2-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ph ph-notebook text-[20px]\" data-kid=\"1-3-2-1-2-1-1-1-1\" style=\"color:#64748b;width:20px;height:20px\">\n                                </i>\n                            </span>\n                            <h3 class=\"text-lg font-extrabold text-[#172033]\" data-kid=\"1-3-2-1-2-1-1-2\">\n                                Avant Loka\n                            </h3>\n                        </div>\n                        <ul class=\"mt-7 space-y-4 text-sm leading-6 text-slate-600\" data-kid=\"1-3-2-1-2-1-2\">\n                            <li class=\"flex gap-3\" data-kid=\"1-3-2-1-2-1-2-1\">\n                                <i aria-hidden=\"true\" class=\"ph ph-minus-circle mt-1 text-[18px]\" data-kid=\"1-3-2-1-2-1-2-1-1\" style=\"color:#94a3b8;width:18px;height:18px\">\n                                </i>\n                                <span data-kid=\"1-3-2-1-2-1-2-1-2\">\n                                    Les paiements arrivent sur plusieurs canaux, sans historique unique.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-3-2-1-2-1-2-2\">\n                                <i aria-hidden=\"true\" class=\"ph ph-minus-circle mt-1 text-[18px]\" data-kid=\"1-3-2-1-2-1-2-2-1\" style=\"color:#94a3b8;width:18px;height:18px\">\n                                </i>\n                                <span data-kid=\"1-3-2-1-2-1-2-2-2\">\n                                    Les quittances sont recréées à la main et envoyées au cas par cas.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-3-2-1-2-1-2-3\">\n                                <i aria-hidden=\"true\" class=\"ph ph-minus-circle mt-1 text-[18px]\" data-kid=\"1-3-2-1-2-1-2-3-1\" style=\"color:#94a3b8;width:18px;height:18px\">\n                                </i>\n                                <span data-kid=\"1-3-2-1-2-1-2-3-2\">\n                                    Une information importante reste dans un cahier, un fichier ou un message.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"reveal rounded-[22px] bg-indigo-600 p-7 text-white shadow-[0_24px_50px_-26px_rgba(79,70,229,0.8)] sm:p-9\" data-kid=\"1-3-2-1-2-2\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-2-2-1\">\n                            <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-white/15\" data-kid=\"1-3-2-1-2-2-1-1\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check-circle text-[20px]\" data-kid=\"1-3-2-1-2-2-1-1-1\" style=\"color:#fff;width:20px;height:20px\">\n                                </i>\n                            </span>\n                            <h3 class=\"text-lg font-extrabold\" data-kid=\"1-3-2-1-2-2-1-2\">\n                                Avec Loka\n                            </h3>\n                        </div>\n                        <ul class=\"mt-7 space-y-4 text-sm leading-6 text-indigo-50\" data-kid=\"1-3-2-1-2-2-2\">\n                            <li class=\"flex gap-3\" data-kid=\"1-3-2-1-2-2-2-1\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check-circle mt-1 text-[18px]\" data-kid=\"1-3-2-1-2-2-2-1-1\" style=\"color:#c7d2fe;width:18px;height:18px\">\n                                </i>\n                                <span data-kid=\"1-3-2-1-2-2-2-1-2\">\n                                    Chaque règlement est rattaché au bon logement et au bon locataire.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-3-2-1-2-2-2-2\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check-circle mt-1 text-[18px]\" data-kid=\"1-3-2-1-2-2-2-2-1\" style=\"color:#c7d2fe;width:18px;height:18px\">\n                                </i>\n                                <span data-kid=\"1-3-2-1-2-2-2-2-2\">\n                                    La quittance PDF est prête dès que le paiement est confirmé.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-3-2-1-2-2-2-3\">\n                                <i aria-hidden=\"true\" class=\"ph ph-check-circle mt-1 text-[18px]\" data-kid=\"1-3-2-1-2-2-2-3-1\" style=\"color:#c7d2fe;width:18px;height:18px\">\n                                </i>\n                                <span data-kid=\"1-3-2-1-2-2-2-3-2\">\n                                    Vous savez ce qui est payé, attendu ou à relancer — sans refaire les calculs.\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white px-5 py-24 sm:px-8 lg:px-10 lg:py-28\" data-kid=\"1-3-3\" id=\"fonctionnalites\">\n            <div class=\"mx-auto max-w-6xl\" data-kid=\"1-3-3-1\">\n                <div class=\"reveal mx-auto max-w-[680px] text-center\" data-kid=\"1-3-3-1-1\">\n                    <p class=\"text-sm font-extrabold text-indigo-600\" data-kid=\"1-3-3-1-1-1\">\n                        Les outils qui font gagner du temps\n                    </p>\n                    <h2 class=\"mt-4 text-3xl font-extrabold tracking-[-0.045em] text-[#172033] sm:text-5xl\" data-kid=\"1-3-3-1-1-2\">\n                        Un espace simple pour chaque étape.\n                    </h2>\n                    <p class=\"mt-5 text-base leading-8 text-slate-600\" data-kid=\"1-3-3-1-1-3\">\n                        Pas besoin d'être expert en logiciel : chaque écran vous aide à faire la prochaine action utile.\n                    </p>\n                </div>\n                <div class=\"mt-14 grid gap-5 sm:grid-cols-2\" data-kid=\"1-3-3-1-2\">\n                    <article class=\"reveal rounded-[22px] border border-slate-200 bg-white p-7 shadow-[0_20px_45px_-38px_rgba(23,32,51,0.65)] sm:p-8\" data-kid=\"1-3-3-1-2-1\">\n                        <div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50\" data-kid=\"1-3-3-1-2-1-1\">\n                            <i aria-hidden=\"true\" class=\"ph ph-device-mobile text-[25px]\" data-kid=\"1-3-3-1-2-1-1-1\" style=\"color:#4f46e5;width:25px;height:25px\">\n                            </i>\n                        </div>\n                        <h3 class=\"mt-6 text-lg font-extrabold text-[#172033]\" data-kid=\"1-3-3-1-2-1-2\">\n                            Encaissez par Mobile Money\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-slate-600\" data-kid=\"1-3-3-1-2-1-3\">\n                            MTN MoMo, Moov Money ou carte : le locataire choisit son canal et vous retrouvez le règlement au même endroit.\n                        </p>\n                        <a class=\"mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-indigo-700 hover:text-indigo-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-3-1-2-1-4\" href=\"#portail-locataire\">\n                            <span data-kid=\"1-3-3-1-2-1-4-1\">\n                                Découvrir le parcours\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-arrow-right text-[17px]\" data-kid=\"1-3-3-1-2-1-4-2\" style=\"color:#4f46e5;width:17px;height:17px\">\n                            </i>\n                        </a>\n                    </article>\n                    <article class=\"reveal rounded-[22px] border border-slate-200 bg-white p-7 shadow-[0_20px_45px_-38px_rgba(23,32,51,0.65)] sm:p-8\" data-kid=\"1-3-3-1-2-2\">\n                        <div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50\" data-kid=\"1-3-3-1-2-2-1\">\n                            <i aria-hidden=\"true\" class=\"ph ph-file-text text-[25px]\" data-kid=\"1-3-3-1-2-2-1-1\" style=\"color:#4f46e5;width:25px;height:25px\">\n                            </i>\n                        </div>\n                        <h3 class=\"mt-6 text-lg font-extrabold text-[#172033]\" data-kid=\"1-3-3-1-2-2-2\">\n                            Générez les quittances\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-slate-600\" data-kid=\"1-3-3-1-2-2-3\">\n                            Une quittance claire et personnalisable, prête à télécharger ou partager après chaque paiement confirmé.\n                        </p>\n                        <a class=\"mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-indigo-700 hover:text-indigo-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-3-1-2-2-4\" href=\"#faq\">\n                            <span data-kid=\"1-3-3-1-2-2-4-1\">\n                                Voir les réponses\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-arrow-right text-[17px]\" data-kid=\"1-3-3-1-2-2-4-2\" style=\"color:#4f46e5;width:17px;height:17px\">\n                            </i>\n                        </a>\n                    </article>\n                    <article class=\"reveal rounded-[22px] border border-slate-200 bg-white p-7 shadow-[0_20px_45px_-38px_rgba(23,32,51,0.65)] sm:p-8\" data-kid=\"1-3-3-1-2-3\">\n                        <div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50\" data-kid=\"1-3-3-1-2-3-1\">\n                            <i aria-hidden=\"true\" class=\"ph ph-buildings text-[25px]\" data-kid=\"1-3-3-1-2-3-1-1\" style=\"color:#4f46e5;width:25px;height:25px\">\n                            </i>\n                        </div>\n                        <h3 class=\"mt-6 text-lg font-extrabold text-[#172033]\" data-kid=\"1-3-3-1-2-3-2\">\n                            Pilotez plusieurs biens\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-slate-600\" data-kid=\"1-3-3-1-2-3-3\">\n                            Agences et gestionnaires suivent leurs logements, propriétaires, commissions et reversements avec une vue structurée.\n                        </p>\n                        <a class=\"mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-indigo-700 hover:text-indigo-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-3-1-2-3-4\" href=\"#tarifs\">\n                            <span data-kid=\"1-3-3-1-2-3-4-1\">\n                                Comparer les plans\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-arrow-right text-[17px]\" data-kid=\"1-3-3-1-2-3-4-2\" style=\"color:#4f46e5;width:17px;height:17px\">\n                            </i>\n                        </a>\n                    </article>\n                    <article class=\"reveal rounded-[22px] border border-slate-200 bg-white p-7 shadow-[0_20px_45px_-38px_rgba(23,32,51,0.65)] sm:p-8\" data-kid=\"1-3-3-1-2-4\">\n                        <div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50\" data-kid=\"1-3-3-1-2-4-1\">\n                            <i aria-hidden=\"true\" class=\"ph ph-user-circle text-[25px]\" data-kid=\"1-3-3-1-2-4-1-1\" style=\"color:#4f46e5;width:25px;height:25px\">\n                            </i>\n                        </div>\n                        <h3 class=\"mt-6 text-lg font-extrabold text-[#172033]\" data-kid=\"1-3-3-1-2-4-2\">\n                            Offrez un portail locataire\n                        </h3>\n                        <p class=\"mt-3 text-sm leading-7 text-slate-600\" data-kid=\"1-3-3-1-2-4-3\">\n                            Vos locataires consultent leurs paiements, téléchargent leurs documents et savent où en est leur dossier.\n                        </p>\n                        <a class=\"mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-indigo-700 hover:text-indigo-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-3-3-1-2-4-4\" href=\"#portail-locataire\">\n                            <span data-kid=\"1-3-3-1-2-4-4-1\">\n                                Voir le portail\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ph ph-arrow-right text-[17px]\" data-kid=\"1-3-3-1-2-4-4-2\" style=\"color:#4f46e5;width:17px;height:17px\">\n                            </i>\n                        </a>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-slate-50 px-5 py-24 sm:px-8 lg:px-10 lg:py-28\" data-kid=\"1-3-4\" id=\"portail-locataire\">\n            <div class=\"mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20\" data-kid=\"1-3-4-1\">\n                <div class=\"reveal\" data-kid=\"1-3-4-1-1\">\n                    <p class=\"text-sm font-extrabold text-indigo-600\" data-kid=\"1-3-4-1-1-1\">\n                        Un lien plus simple avec vos locataires\n                    </p>\n                    <h2 class=\"mt-4 text-3xl font-extrabold tracking-[-0.045em] text-[#172033] sm:text-5xl\" data-kid=\"1-3-4-1-1-2\">\n                        Vos documents restent accessibles, même après le paiement.\n                    </h2>\n                    <p class=\"mt-5 text-base leading-8 text-slate-600\" data-kid=\"1-3-4-1-1-3\">\n                        Le portail locataire réduit les messages de suivi et donne à chacun une réponse claire : montant, date, quittance et prochaine échéance.\n                    </p>\n                    <a class=\"mt-8 group inline-flex min-h-12 items-center gap-2 rounded-xl bg-[#172033] px-5 text-sm font-bold text-white hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200\" data-kid=\"1-3-4-1-1-4\" href=\"/login?tab=signup\">\n                        <span data-kid=\"1-3-4-1-1-4-1\">\n                            Tester le portail\n                        </span>\n                        <i aria-hidden=\"true\" class=\"arrow-nudge ph ph-arrow-right text-[18px]\" data-kid=\"1-3-4-1-1-4-2\" style=\"color:#fff;width:18px;height:18px\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"reveal rounded-[24px] border border-slate-200 bg-white p-4 shadow-[0_28px_70px_-42px_rgba(23,32,51,0.55)] sm:p-6\" data-kid=\"1-3-4-1-2\">\n                    <div class=\"rounded-[18px] bg-slate-50 p-5 sm:p-7\" data-kid=\"1-3-4-1-2-1\">\n                        <div class=\"flex items-center justify-between border-b border-slate-200 pb-5\" data-kid=\"1-3-4-1-2-1-1\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-4-1-2-1-1-1\">\n                                <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100\" data-kid=\"1-3-4-1-2-1-1-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ph ph-house-line text-[21px]\" data-kid=\"1-3-4-1-2-1-1-1-1-1\" style=\"color:#4f46e5;width:21px;height:21px\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"1-3-4-1-2-1-1-1-2\">\n                                    <p class=\"text-sm font-extrabold text-[#172033]\" data-kid=\"1-3-4-1-2-1-1-1-2-1\">\n                                        Mon espace locataire\n                                    </p>\n                                    <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-3-4-1-2-1-1-1-2-2\">\n                                        Appartement A2 · Fidjrossè\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-extrabold text-emerald-700\" data-kid=\"1-3-4-1-2-1-1-2\">\n                                À jour\n                            </span>\n                        </div>\n                        <div class=\"mt-5 rounded-2xl bg-white p-5 ring-1 ring-slate-200\" data-kid=\"1-3-4-1-2-1-2\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-3-4-1-2-1-2-1\">\n                        