d=\"2-3-5-2-1-1-1\">\n                            <div data-kid=\"2-3-5-2-1-1-1-1\">\n                                <p class=\"text-[11px] font-extrabold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"2-3-5-2-1-1-1-1-1\">\n                                    Quittance de loyer\n                                </p>\n                                <p class=\"mt-3 text-[28px] font-black tracking-[-0.06em] text-indigo-950\" data-kid=\"2-3-5-2-1-1-1-1-2\">\n                                    Loka\n                                </p>\n                            </div>\n                            <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-white shadow-sm\" data-kid=\"2-3-5-2-1-1-1-2\">\n                                <i aria-hidden=\"true\" class=\"ph ph-file-pdf text-[20px]\" data-kid=\"2-3-5-2-1-1-1-2-1\" style=\"color:#3730a3;width:20px;height:20px\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"mt-7 border-t border-slate-200 pt-5\" data-kid=\"2-3-5-2-1-1-2\">\n                            <div class=\"flex justify-between text-[12px]\" data-kid=\"2-3-5-2-1-1-2-1\">\n                                <span class=\"text-slate-500\" data-kid=\"2-3-5-2-1-1-2-1-1\">\n                                    Locataire\n                                </span>\n                                <span class=\"font-bold text-slate-900\" data-kid=\"2-3-5-2-1-1-2-1-2\">\n                                    Marie Dossou\n                                </span>\n                            </div>\n                            <div class=\"mt-4 flex justify-between text-[12px]\" data-kid=\"2-3-5-2-1-1-2-2\">\n                                <span class=\"text-slate-500\" data-kid=\"2-3-5-2-1-1-2-2-1\">\n                                    Bien\n                                </span>\n                                <span class=\"font-bold text-slate-900\" data-kid=\"2-3-5-2-1-1-2-2-2\">\n                                    Appartement 302\n                                </span>\n                            </div>\n                            <div class=\"mt-6 flex items-end justify-between\" data-kid=\"2-3-5-2-1-1-2-3\">\n                                <span class=\"text-[12px] text-emerald-700\" data-kid=\"2-3-5-2-1-1-2-3-1\">\n                                    Document conforme\n                                </span>\n                                <span class=\"text-[26px] font-black tracking-[-0.05em] text-indigo-950\" data-kid=\"2-3-5-2-1-1-2-3-2\">\n                                    150 000 FCFA\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"order-1 lg:order-2\" data-kid=\"2-3-5-2-2\">\n                    <p class=\"text-[12px] font-extrabold uppercase tracking-[0.18em] text-indigo-700\" data-kid=\"2-3-5-2-2-1\">\n                        Un document qui reste\n                    </p>\n                    <h2 class=\"mt-5 max-w-[520px] text-[clamp(2.7rem,4.4vw,4rem)] font-black leading-[0.98] tracking-[-0.07em] text-slate-950\" data-kid=\"2-3-5-2-2-2\">\n                        Vos documents restent accessibles, même après le paiement.\n                    </h2>\n                    <p class=\"mt-7 max-w-[490px] text-[17px] leading-8 text-slate-600\" data-kid=\"2-3-5-2-2-3\">\n                        La quittance est disponible dans le portail, sous votre identité, avec le montant, la date et l'historique utiles au locataire.\n                    </p>\n                    <a class=\"mt-8 inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-indigo-700 px-6 py-3.5 text-[14px] font-bold text-white shadow-lg shadow-indigo-700/20 hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700\" data-