      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css');\n  body { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n  .tabular { font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"min-h-screen overflow-x-hidden bg-white text-[#172033] antialiased selection:bg-indigo-100 selection:text-indigo-900\" data-kid=\"1\" data-name=\"main page container\" id=\"top\">\n    <div aria-hidden=\"true\" class=\"fixed left-0 top-0 z-[60] h-1 w-full origin-left scale-x-0 bg-indigo-600\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"scroll progress indicator bar\" data-reason=\"scale property animated by scroll-triggered script\" id=\"scroll-progress\">\n    </div>\n    <header class=\"sticky top-0 z-50 border-b border-slate-200/70 bg-white/95 shadow-[0_8px_30px_-24px_rgba(23,32,51,0.45)] backdrop-blur-xl\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"site navigation header\" data-reason=\"shadow class toggled by scroll event listener\" id=\"site-nav\">\n        <div class=\"mx-auto flex min-h-[76px] max-w-7xl items-center justify-between gap-6 px-5 sm:px-8 lg:px-10\" data-kid=\"1-2-1\">\n            <a aria-label=\"Loka, accueil\" class=\"flex min-h-11 shrink-0 items-center gap-3 rounded-xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-2-1-1\" href=\"#top\">\n                <img alt=\"Logo Loka\" class=\"h-12 w-12 rounded-2xl border border-slate-200 bg-white object-contain p-1 shadow-sm\" data-kid=\"1-2-1-1-1\" decoding=\"async\" height=\"48\" loading=\"lazy\" src=\"/api/local/images/public/logo.jpg\" width=\"48\"/>\n                <span class=\"hidden leading-tight sm:block\" data-kid=\"1-2-1-1-2\">\n                    <span class=\"block text-[18px] font-extrabold tracking-[-0.03em] text-[#172033]\" data-kid=\"1-2-1-1-2-1\">\n                        Loka\n                    </span>\n                    <span class=\"block text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"1-2-1-1-2-2\">\n                        Gestion locative · Bénin\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Navigation principale\" class=\"hidden items-center gap-1 lg:flex\" data-kid=\"1-2-1-2\">\n                <a class=\"flex min-h-11 items-center rounded-xl px-4 text-sm font-semibold text-slate-600 hover:bg-slate-50 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-2-1-2-1\" href=\"#fonctionnalites\">\n                    Fonctionnalités\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-xl px-4 text-sm font-semibold text-slate-600 hover:bg-slate-50 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-2-1-2-2\" href=\"#portail-locataire\">\n                    Portail locataire\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-xl px-4 text-sm font-semibold text-slate-600 hover:bg-slate-50 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-2-1-2-3\" href=\"#tarifs\">\n                    Tarifs\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-xl px-4 text-sm font-semibold text-slate-600 hover:bg-slate-50 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-2-1-2-4\" href=\"#faq\">\n                    FAQ\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2 sm:gap-3\" data-kid=\"1-2-1-3\">\n                <a class=\"flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-slate-600 hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-100\" data-kid=\"1-2-1-3-1\" href=\"/login\">\n                    Connexion\n                </a>\n                <a class=\"group flex min-h-11 items-center gap-2 rounded-xl bg-indigo-600 px-4 text-sm font-bold text-white shadow-[0_12px_24px_-12px_rgba(79,70,229,0.65)] hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-indigo-200 sm:px-5\" data-kid=\"1-2-1-3-2\" href=\"/login?tab=signup\">\n                    <span data-kid=\"1-2-1-3-2-1\">\n                        Essai gratuit\n                    </span>\n                    <i aria-hidden=\"true\" class=\"ph ph-arrow-up-right text-[18px]\" data-kid=\"1-2-1-3-2-2\" style=\"color:#fff;width:18px;height:18px\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-3\">\n        <section class=\"relative overflow-hidden bg-[radial-gradient(circle_at_50%_0%,#e0e7ff_0%,#f8fafc_34%,#ffffff_68%)] px-5 pb-20 pt-16 sm:px-8 sm:pb-24 sm:pt-24 lg:px-10 lg:pt-28\" data-kid=\"1-3-1\">\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute left-1/2 top-0 h-[360px] w-[680px] -translate-x-1/2 rounded-full bg-indigo-100/35 blur-3xl\" data-kid=\"1-3-1-1\" data-name=\"decorative background blur\">\n            </div>\n            <div class=\"relative mx-auto max-w-[900px] text-center\" data-kid=\"1-3-1-2\">\n                <div class=\"reveal mx-auto inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/80 px-4 py-2 text-xs font-bold text-indigo-700 shadow-sm\" data-kid=\"1-3-1-2-1\">\n                    <i aria-hidden=\"true\" class=\"ph ph-sparkle text-[16px]\" data-kid=\"1-3-1-2-1-1\" style=\"color:#4f46e5;width:16px;height:16px\">\n                    </i>\n                    <span data-kid=\"1-3-1-2-1-2\" data-name=\"hero section pre-headline label\">\n                        Direction 1 · Indigo Air\n                    </span>\n    